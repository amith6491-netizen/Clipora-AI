# Clipora AI Environment Template
# Copy to backend/.env and frontend/.env as needed

MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=clipora_ai

# Upload duration bounds: at least 10s and up to 20 minutes (1200 seconds)
MIN_VIDEO_DURATION_SECONDS=10
MAX_VIDEO_DURATION_SECONDS=1200

# Faster-Whisper model: tiny, base, small, medium, large-v3
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto

# Target generated shorts bounds
MIN_SHORTS_COUNT=5
MAX_SHORTS_COUNT=15
MIN_CLIP_DURATION_SECONDS=10.0
MAX_CLIP_DURATION_SECONDS=20.0

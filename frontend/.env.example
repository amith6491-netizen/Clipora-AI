# Dev Vite proxy target (when running frontend locally via `npm run dev`)
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Optional for split production hosting (e.g. Vercel frontend -> Render/EC2 backend):
# Leave empty when using Vite dev proxy or Nginx reverse proxy on the same domain.
VITE_API_BASE_URL=

MONGODB_URI=mongodb+srv://clipora-admin:clipora123@cluster0.0vcsdkb.mongodb.net/
MONGODB_DB=clipora_ai
STORAGE_DIR=./storage
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Upload rules (up to 20 minutes)
MIN_VIDEO_DURATION_SECONDS=10
MAX_VIDEO_DURATION_SECONDS=1200
MAX_UPLOAD_SIZE_MB=2048

# Authentication
AUTH_SECRET_KEY=clipora-dev-secret-change-in-production
AUTH_TOKEN_EXPIRE_HOURS=72

# AI Pipeline Models
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto
NLP_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Shorts generation bounds
MIN_SHORTS_COUNT=5
MAX_SHORTS_COUNT=15
MIN_CLIP_DURATION_SECONDS=10.0
MAX_CLIP_DURATION_SECONDS=20.0
